import { ListView } from "std-widgets.slint";
import { Theme, Label, Heading, Rule, Action, Choice, Range, Meter } from "controls.slint";
import { OutputHelp } from "output-help.slint";
import { WindowTitleBar } from "window-title-bar.slint";
import "fonts/host-grotesk.ttf";
import "fonts/instrument-sans.ttf";

export struct FileRowView {
    name: string,
    codec: string,
    resolution: string,
    duration: string,
    state: string,
    progress: float,
    show-progress: bool,
    included: bool,
}

component FileCells inherits HorizontalLayout {
    in property <string> file-name;
    in property <string> codec;
    in property <string> resolution;
    in property <string> duration;
    in property <color> ink: Theme.secondary;
    in property <int> size: 13;
    padding-left: 12px;
    padding-right: 12px;
    spacing: 8px;
    Label { min-width: 0px; horizontal-stretch: 1; font-size: root.size * 1px; color: root.ink; text: root.file-name; }
    Label { width: 72px; font-size: root.size * 1px; color: root.ink; text: root.codec; }
    Label { width: 96px; font-size: root.size * 1px; color: root.ink; text: root.resolution; }
    Label { width: 61px; font-size: root.size * 1px; color: root.ink; text: root.duration; }
}

component FileRow inherits Rectangle {
    in property <FileRowView> file-view;
    in property <bool> selected;
    callback inspected();

    height: 63px;
    background: root.selected || touch.has-hover ? Theme.surface : Theme.ground;
    border-width: keys.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.file-view.name + ", " + root.file-view.state;
    accessible-action-default => { root.inspected(); }

    if root.selected: Rectangle { x: 0; width: 1px; height: parent.height; background: Theme.accent; }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }

    VerticalLayout {
        padding-top: 5px;
        padding-bottom: 7px;
        spacing: 2px;
        FileCells {
            file-name: root.file-view.name;
            codec: root.file-view.codec;
            resolution: root.file-view.resolution;
            duration: root.file-view.duration;
        }
        Label {
            x: 12px;
            width: parent.width - 24px;
            font-size: 12px;
            color: root.file-view.show-progress ? Theme.accent : Theme.muted;
            text: root.file-view.state + (root.file-view.included ? "" : " · fora da fila");
        }
        if root.file-view.show-progress: Rectangle {
            height: 3px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Meter { fraction: root.file-view.progress; height: 3px; }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { keys.focus(); root.inspected(); }
    }
    keys := FocusScope {
        x: 0;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.inspected();
                return accept;
            }
            return reject;
        }
    }
}

component Detail inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 2px;
    Label { text: root.label; font-size: 12px; color: Theme.muted; }
    Label { text: root.value; font-size: 14px; min-width: 0px; }
}

component ChoiceField inherits VerticalLayout {
    in property <string> label;
    in property <[string]> options;
    in property <[string]> option-descriptions;
    in property <bool> enabled: true;
    in property <length> menu-width;
    in property <bool> align-menu-right;
    in-out property <int> current-index;
    callback changed-index(int);

    spacing: 4px;
    Label { text: root.label; color: Theme.muted; font-size: 12px; }
    choice := Choice {
        label: root.label;
        options: root.options;
        option-descriptions: root.option-descriptions;
        enabled: root.enabled && root.options.length > 0;
        menu-width: root.menu-width;
        align-menu-right: root.align-menu-right;
        current-index <=> root.current-index;
        changed-index(index) => { root.changed-index(index); }
    }
    if choice.selected-description != "": Label {
        text: choice.selected-description;
        min-width: 0px;
        wrap: word-wrap;
        font-size: 12px;
        color: Theme.muted;
    }
}

export component DesktopWindow inherits Window {
    title: "Velox Transcode";
    no-frame: true;
    icon: @image-url("../web/assets/velox-transcode.svg");
    default-font-family: "Instrument Sans";
    default-font-size: 16px;
    min-width: 880px;
    min-height: 640px;
    preferred-width: 1000px;
    preferred-height: 680px;
    background: Theme.ground;

    in property <[FileRowView]> files;
    in property <int> selected-file: -1;
    in property <string> detail-fps: "—";
    in property <string> detail-bitrate: "—";
    in property <string> detail-size: "—";
    in property <string> detail-message;
    in property <bool> detail-recover-audio;
    in property <bool> detail-can-toggle;
    in property <bool> detail-included;
    in property <bool> picking;
    in property <bool> busy;
    in property <bool> queue-action-enabled;
    in property <string> queue-action: "Iniciar fila";
    in property <string> queue-status: "Adicione arquivos para começar.";
    in property <int> queue-percent;
    in property <float> queue-fraction;
    in property <string> queue-message;
    in property <bool> detecting: true;
    in property <string> encoder-message;
    in property <string> prores-message;
    in property <[string]> encoders;
    in property <[string]> presets;
    in property <[string]> preset-descriptions;
    in property <[string]> profiles;
    in property <[string]> profile-descriptions;
    in property <[string]> prores-profiles;
    in property <string> quality-code;
    in property <string> quality-explanation;
    in property <int> quality-minimum: 18;
    in property <int> quality-maximum: 28;
    in property <string> destination;
    in-out property <int> codec-index;
    out property <bool> prores: codec-index == 1;
    in-out property <int> encoder-index;
    in-out property <int> preset-index;
    in-out property <int> profile-index;
    in-out property <int> quality: 22;
    in-out property <int> audio-index;
    in-out property <int> container-index;
    in-out property <int> prores-profile-index;
    in-out property <int> prores-audio-index;

    callback pick-files();
    callback pick-destination();
    callback inspect(int);
    callback toggle-inclusion();
    callback codec-changed();
    callback encoder-changed(int);
    callback recover-audio();
    callback toggle-queue();
    callback detect-encoders();
    callback resize-from-edge(int, int);
    pure callback has-files(data-transfer) -> bool;
    callback receive-files(data-transfer) -> bool;

    private property <length> resize-margin: 8px;
    private property <string> output-message: prores ? prores-message : encoder-message;
    private property <bool> help-open;
    private property <length> help-anchor;

    VerticalLayout {
        spacing: 0;

        WindowTitleBar {
            title: root.title;
            maximized: root.maximized;
            minimize => { root.minimized = true; }
            toggle-maximize => { root.maximized = !root.maximized; }
            request-close => { root.close(); }
        }

        Rule {}

        HorizontalLayout {
            spacing: 0;
            vertical-stretch: 1;

            Rectangle {
                horizontal-stretch: 1;
                min-width: 480px;
                background: Theme.ground;

                VerticalLayout {
                    padding: 16px;
                    spacing: 9px;

                    HorizontalLayout {
                        spacing: 8px;
                        Heading { text: "Arquivos"; }
                        Label { text: "\{root.files.length}"; color: Theme.accent; horizontal-stretch: 1; }
                        Action {
                            label: "Adicionar arquivos";
                            enabled: !root.picking && !root.busy;
                            clicked => { root.pick-files(); }
                        }
                    }

                    Rectangle {
                        height: root.files.length == 0 ? 68px : 42px;
                        background: Theme.surface;
                        border-radius: Theme.radius;
                        border-color: drop.current-action == DragAction.copy ? Theme.accent : Theme.control-border;
                        border-width: 1px;
                        Label {
                            text: root.picking ? "Aguardando o seletor do sistema…" : "Arraste vídeos para cá";
                            color: drop.current-action == DragAction.copy ? Theme.accent : Theme.secondary;
                            horizontal-alignment: center;
                        }
                        drop := DropArea {
                            can-drop(event) => {
                                !root.busy && root.has-files(event.data) ? DragAction.copy : DragAction.none
                            }
                            dropped(event) => {
                                !root.busy && root.receive-files(event.data) ? DragAction.copy : DragAction.none
                            }
                        }
                    }

                    FileCells {
                        height: 22px;
                        file-name: "Arquivo";
                        codec: "Codec";
                        resolution: "Resolução";
                        duration: "Duração";
                        size: 12;
                        ink: Theme.muted;
                    }

                    Rule {}
                    Rectangle {
                        vertical-stretch: 1;
                        if root.files.length == 0: Label {
                            text: "Os metadados dos vídeos aparecem aqui.";
                            color: Theme.muted;
                            horizontal-alignment: center;
                        }
                        ListView {
                            for row[index] in root.files: FileRow {
                                file-view: row;
                                selected: index == root.selected-file;
                                inspected => { root.inspect(index); }
                            }
                        }
                    }
                    Rule {}

                    HorizontalLayout {
                        spacing: 12px;
                        Detail { label: "FPS"; value: root.detail-fps; horizontal-stretch: 1; }
                        Detail { label: "Bitrate"; value: root.detail-bitrate; horizontal-stretch: 1; }
                        Detail { label: "Tamanho"; value: root.detail-size; horizontal-stretch: 1; }
                        if root.selected-file >= 0: Action {
                            label: root.detail-included ? "Excluir da fila" : "Incluir na fila";
                            enabled: root.detail-can-toggle && !root.busy;
                            clicked => { root.toggle-inclusion(); }
                        }
                    }

                    if root.detail-message != "": HorizontalLayout {
                        spacing: 9px;
                        Label {
                            text: root.detail-message;
                            min-width: 0px;
                            wrap: word-wrap;
                            font-size: 12px;
                            color: Theme.muted;
                            horizontal-stretch: 1;
                            min-height: 32px;
                            max-height: 58px;
                        }
                        if root.detail-recover-audio: Action {
                            label: root.prores ? "Usar PCM 24 bits" : "Usar AAC 192 kbps";
                            enabled: !root.busy;
                            clicked => { root.recover-audio(); }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.separator; }

            output-panel := Rectangle {
                min-width: 338px;
                preferred-width: 350px;
                horizontal-stretch: 0;
                background: Theme.surface;
                VerticalLayout {
                    padding: 17px;
                    spacing: 9px;
                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        Heading { text: "Saída"; horizontal-stretch: 1; }
                        Choice {
                            width: 132px;
                            label: "Codec de saída";
                            options: ["H.264", "ProRes"];
                            enabled: !root.busy;
                            current-index <=> root.codec-index;
                            changed-index(index) => { root.codec-changed(); }
                        }
                    }

                    if !root.prores: ChoiceField {
                        label: "Encoder";
                        options: root.encoders;
                        enabled: !root.busy && !root.detecting;
                        current-index <=> root.encoder-index;
                        changed-index(index) => { root.encoder-changed(index); }
                    }
                    if root.prores: VerticalLayout {
                        spacing: 4px;
                        Label { text: "Encoder"; color: Theme.muted; font-size: 12px; }
                        Label { text: "ProRes · CPU"; }
                    }
                    if root.detecting: Label { text: "Verificando os encoders…"; color: Theme.muted; font-size: 12px; }
                    if root.output-message != "" && !root.detecting: VerticalLayout {
                        spacing: 6px;
                        Label { text: root.output-message; color: Theme.muted; wrap: word-wrap; font-size: 12px; min-width: 0px; }
                        Action { label: "Verificar encoders"; enabled: !root.busy; clicked => { root.detect-encoders(); } }
                    }

                    if !root.prores: VerticalLayout {
                        spacing: 2px;
                        vertical-stretch: 0;
                        HorizontalLayout {
                            Label { text: "Qualidade do vídeo"; font-size: 13px; horizontal-stretch: 1; }
                            Label {
                                text: root.quality-code == "" ? "\{root.quality}" : "\{root.quality-code} \{root.quality}";
                                color: Theme.accent;
                                font-size: 13px;
                            }
                        }
                        Range {
                            label: root.quality-code == "" ? "Qualidade do vídeo" : "Qualidade do vídeo, " + root.quality-code;
                            minimum: root.quality-minimum;
                            maximum: root.quality-maximum;
                            enabled: !root.busy && !root.detecting && root.encoders.length > 0;
                            value <=> root.quality;
                        }
                        HorizontalLayout {
                            Label { text: "Mais detalhes (\{root.quality-minimum})"; color: Theme.muted; font-size: 12px; }
                            Rectangle { horizontal-stretch: 1; }
                            Label { text: "Arquivo menor (\{root.quality-maximum})"; color: Theme.muted; font-size: 12px; }
                        }
                    }

                    if !root.prores: HorizontalLayout {
                        spacing: 9px;
                        ChoiceField {
                            label: "Velocidade (preset)";
                            options: root.presets;
                            option-descriptions: root.preset-descriptions;
                            menu-width: parent.width;
                            enabled: !root.busy && !root.detecting && root.presets.length > 1;
                            current-index <=> root.preset-index;
                        }
                        ChoiceField {
                            label: "Perfil H.264";
                            options: root.profiles;
                            option-descriptions: root.profile-descriptions;
                            menu-width: parent.width;
                            align-menu-right: true;
                            enabled: !root.busy && !root.detecting;
                            current-index <=> root.profile-index;
                        }
                    }

                    if !root.prores: HorizontalLayout {
                        alignment: end;
                        Action {
                            private property <bool> is-open: root.help-open;
                            label: "Entenda os ajustes";
                            min-height: 30px;
                            clicked => {
                                root.help-anchor = self.absolute-position.y;
                                root.help-open = true;
                                help.focus();
                            }
                            changed is-open => {
                                if !self.is-open { self.take-focus(); }
                            }
                        }
                    }

                    if !root.prores: HorizontalLayout {
                        spacing: 9px;
                        ChoiceField {
                            label: "Áudio"; options: ["Copy", "AAC 192 kbps", "AAC 320 kbps"];
                            enabled: !root.busy;
                            current-index <=> root.audio-index;
                        }
                        ChoiceField {
                            label: "Container"; options: ["MP4", "MKV", "MOV"];
                            enabled: !root.busy;
                            current-index <=> root.container-index;
                        }
                    }

                    if root.prores: ChoiceField {
                        label: "Perfil ProRes"; options: root.prores-profiles;
                        enabled: !root.busy && !root.detecting;
                        current-index <=> root.prores-profile-index;
                    }
                    if root.prores: HorizontalLayout {
                        spacing: 9px;
                        ChoiceField {
                            label: "Áudio"; options: ["PCM 24 bits", "Copiar"];
                            enabled: !root.busy && !root.detecting && root.prores-profiles.length > 0;
                            current-index <=> root.prores-audio-index;
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Label { text: "Container"; color: Theme.muted; font-size: 12px; }
                            Label { text: "MOV"; min-height: 36px; }
                        }
                    }
                    if root.prores: Label {
                        text: "Formato para edição. O arquivo pode ficar maior.";
                        color: Theme.muted;
                        font-size: 12px;
                        min-width: 0px;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }
                    Rule {}
                    Label { text: "Pasta de destino"; color: Theme.muted; font-size: 12px; }
                    Label {
                        text: root.destination == "" ? "Selecione onde salvar os vídeos." : root.destination;
                        min-width: 0px;
                    }
                    Action {
                        label: "Escolher pasta";
                        enabled: !root.picking && !root.busy;
                        clicked => { root.pick-destination(); }
                    }
                }
            }
        }

        Rule {}

        Rectangle {
            min-height: 88px;
            background: Theme.surface;

            HorizontalLayout {
                padding: 16px;
                spacing: 16px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    HorizontalLayout {
                        Heading { text: "Fila de conversão"; font-size: 16px; horizontal-stretch: 1; }
                        Label { text: "\{root.queue-percent}%"; color: Theme.accent; font-size: 13px; }
                    }
                    Meter { label: "Progresso da fila"; fraction: root.queue-fraction; height: 4px; }
                    Label {
                        min-width: 0px;
                        font-size: 13px;
                        text: root.queue-message == "" ? root.queue-status : root.queue-message;
                        color: Theme.muted;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Action {
                        label: root.queue-action;
                        height: 40px;
                        enabled: root.queue-action-enabled && (root.busy || !root.picking);
                        primary: !root.busy;
                        clicked => { root.toggle-queue(); }
                    }
                }
            }
        }
    }

    if root.help-open: TouchArea {
        clicked => { root.help-open = false; }
    }
    help := OutputHelp {
        visible: root.help-open;
        enabled: root.help-open;
        width: output-panel.width - 34px;
        x: output-panel.x + 17px;
        y: max(8px, root.help-anchor - self.height - 6px);
        quality-explanation: root.quality-explanation;
        closed => { root.help-open = false; }
    }

    for edge in [
        { horizontal: -1, vertical: -1, cursor: MouseCursor.nwse-resize },
        { horizontal:  0, vertical: -1, cursor: MouseCursor.ns-resize },
        { horizontal:  1, vertical: -1, cursor: MouseCursor.nesw-resize },
        { horizontal: -1, vertical:  0, cursor: MouseCursor.ew-resize },
        { horizontal:  1, vertical:  0, cursor: MouseCursor.ew-resize },
        { horizontal: -1, vertical:  1, cursor: MouseCursor.nesw-resize },
        { horizontal:  0, vertical:  1, cursor: MouseCursor.ns-resize },
        { horizontal:  1, vertical:  1, cursor: MouseCursor.nwse-resize },
    ]: TouchArea {
        enabled: !root.maximized && !root.full-screen;
        x: edge.horizontal < 0 ? 0px : edge.horizontal == 0 ? root.resize-margin : root.width - root.resize-margin;
        y: edge.vertical < 0 ? 0px : edge.vertical == 0 ? root.resize-margin : root.height - root.resize-margin;
        width: edge.horizontal == 0 ? root.width - 2 * root.resize-margin : root.resize-margin;
        height: edge.vertical == 0 ? root.height - 2 * root.resize-margin : root.resize-margin;
        mouse-cursor: edge.cursor;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.resize-from-edge(edge.horizontal, edge.vertical);
            }
        }
    }
}
