export global Theme {
    out property <color> ground: #0f1012;
    out property <color> surface: #161719;
    out property <color> separator: #252729;
    out property <color> control-border: #666b72;
    out property <color> text: #faf9fa;
    out property <color> secondary: #e5e5e4;
    out property <color> muted: #d7d7d6;
    out property <color> accent: #b4d3ff;
    out property <color> inverse: #040404;
    out property <color> inverse-ground: #efedef;
    out property <length> radius: 8px;
}

export component Label inherits Text {
    color: Theme.text;
    font-size: 14px;
    vertical-alignment: center;
    overflow: elide;
}

export component Heading inherits Label {
    font-family: "Host Grotesk";
    font-weight: 500;
    font-size: 19px;
}

export component Rule inherits Rectangle {
    height: 1px;
    background: Theme.separator;
}

export component Action inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked();

    min-height: 38px;
    min-width: caption.preferred-width + 28px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: keys.has-focus || (touch.has-hover && root.enabled) ? Theme.accent :
                  root.primary && root.enabled ? Theme.accent : Theme.control-border;
    background: root.enabled && root.primary ?
                (keys.has-focus || touch.has-hover ? Theme.inverse-ground : Theme.accent) :
                touch.has-hover && root.enabled ? Theme.separator : Theme.surface;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: keys;

    public function take-focus() { keys.focus(); }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keys.focus(); root.clicked(); }
    }

    keys := FocusScope {
        x: 0;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if !event.repeat { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }

    caption := Label {
        horizontal-alignment: center;
        color: root.enabled && root.primary ? Theme.inverse : root.enabled ? Theme.text : Theme.muted;
        text: root.label;
    }
}

export component Choice inherits Rectangle {
    in property <string> label;
    in property <[string]> options;
    in property <[string]> option-descriptions;
    in property <bool> enabled: true;
    in property <length> menu-width;
    in property <bool> align-menu-right;
    in-out property <int> current-index: 0;
    out property <string> selected-description: root.description-at(root.current-index);
    callback changed-index(int);

    private property <string> value: root.options.length > 0 ? root.options[root.current-index] : "—";
    private property <int> cursor-index: 0;
    private property <length> resolved-menu-width: max(root.width, root.menu-width);

    min-height: 36px;
    min-width: 0px;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: keys.has-focus || (touch.has-hover && root.enabled) ? Theme.accent : Theme.control-border;
    background: Theme.ground;

    forward-focus: keys;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.selected-description == "" ? root.value : root.menu-label(root.value, root.current-index);
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.open-menu(); } }

    pure function description-at(index: int) -> string {
        return index >= 0 && index < root.option-descriptions.length ? root.option-descriptions[index] : "";
    }

    pure function menu-label(option: string, index: int) -> string {
        let description = root.description-at(index);
        return description == "" ? option : option + " · " + description;
    }

    function choose(index: int) {
        if index >= 0 && index < root.options.length {
            root.current-index = index;
            root.changed-index(index);
        }
    }

    function open-menu() {
        root.cursor-index = root.current-index;
        menu.show();
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Label {
            min-width: 0px;
            horizontal-stretch: 1;
            text: root.value;
            color: root.enabled ? Theme.text : Theme.muted;
        }
        Rectangle {
            width: 10px;
            Path {
                y: (parent.height - self.height) / 2;
                width: 10px;
                height: 6px;
                stroke: Theme.muted;
                stroke-width: 1.5px;
                commands: "M 1 1 L 5 5 L 9 1";
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keys.focus(); root.open-menu(); }
    }

    keys := FocusScope {
        x: 0;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if !event.repeat { root.open-menu(); }
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                root.choose(clamp(root.current-index + (event.text == Key.UpArrow ? -1 : 1), 0, root.options.length - 1));
                return accept;
            }
            return reject;
        }
    }

    menu := PopupWindow {
        x: root.align-menu-right ? root.width - root.resolved-menu-width : 0px;
        y: root.height + 3px;
        width: root.resolved-menu-width;
        close-policy: close-on-click-outside;
        forward-focus: menu-keys;
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius;
            border-color: Theme.control-border;
            border-width: 1px;
            VerticalLayout {
                padding: 4px;
                for option[index] in root.options: Rectangle {
                    height: 29px;
                    border-radius: 4px;
                    background: index == root.cursor-index ? Theme.separator : transparent;
                    accessible-role: list-item;
                    accessible-label: root.menu-label(option, index);
                    accessible-action-default => { root.choose(index); menu.close(); }
                    Label {
                        x: 6px;
                        width: parent.width - 12px;
                        text: root.menu-label(option, index);
                        color: index == root.cursor-index ? Theme.accent : Theme.text;
                    }
                    item-touch := TouchArea {
                        mouse-cursor: pointer;
                        moved => { root.cursor-index = index; }
                        clicked => { root.choose(index); menu.close(); }
                    }
                }
            }
        }
        menu-keys := FocusScope {
            x: 0;
            width: 0px;
            key-pressed(event) => {
                if event.text == Key.UpArrow || event.text == Key.DownArrow {
                    root.cursor-index = clamp(root.cursor-index + (event.text == Key.UpArrow ? -1 : 1), 0, root.options.length - 1);
                    return accept;
                }
                if event.text == Key.Return || event.text == Key.Space {
                    root.choose(root.cursor-index);
                    menu.close();
                    return accept;
                }
                if event.text == Key.Escape {
                    menu.close();
                    return accept;
                }
                return reject;
            }
        }
    }
}

export component Range inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <int> minimum: 18;
    in property <int> maximum: 28;
    in-out property <int> value: 22;

    height: 26px;
    vertical-stretch: 0;
    border-radius: Theme.radius;
    border-width: keys.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    forward-focus: keys;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: 1;
    accessible-action-increment => { if root.enabled { root.set-value(root.value + 1); } }
    accessible-action-decrement => { if root.enabled { root.set-value(root.value - 1); } }
    accessible-action-set-value(value) => {
        if root.enabled && value.is-float() { root.set-value(Math.round(value.to-float())); }
    }

    function set-value(value: int) {
        root.value = clamp(value, root.minimum, root.maximum);
    }

    rail := Rectangle {
        x: 9px;
        width: root.width - 18px;
        height: 4px;
        border-radius: 2px;
        background: Theme.control-border;
        Rectangle {
            x: 0;
            width: rail.width * (root.value - root.minimum) / (root.maximum - root.minimum);
            height: rail.height;
            border-radius: 2px;
            background: root.enabled ? Theme.accent : Theme.muted;
        }
    }

    Rectangle {
        x: rail.x + rail.width * (root.value - root.minimum) / (root.maximum - root.minimum) - self.width / 2;
        width: 14px;
        height: self.width;
        border-radius: 7px;
        background: root.enabled ? Theme.accent : Theme.muted;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                keys.focus();
                root.set-value(root.minimum + Math.round((self.mouse-x - rail.x) / rail.width * (root.maximum - root.minimum)));
            }
        }
        moved => {
            if self.pressed {
                root.set-value(root.minimum + Math.round((self.mouse-x - rail.x) / rail.width * (root.maximum - root.minimum)));
            }
        }
    }

    keys := FocusScope {
        x: 0;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                root.set-value(root.value + (event.text == Key.LeftArrow ? -1 : 1));
                return accept;
            }
            if event.text == Key.Home || event.text == Key.End {
                root.set-value(event.text == Key.Home ? root.minimum : root.maximum);
                return accept;
            }
            return reject;
        }
    }
}

export component Meter inherits Rectangle {
    in property <float> fraction;
    in property <string> label: "Progresso";
    min-height: 4px;
    border-radius: 2px;
    background: Theme.control-border;
    accessible-role: progress-indicator;
    accessible-label: root.label;
    accessible-value: root.fraction * 100;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.fraction, 0, 1);
        height: parent.height;
        border-radius: 2px;
        background: Theme.accent;
    }
}
